<div
  id="MainBundleProduct-{{ section.id }}"
  class="bundle-pdp section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}{% if section.settings.enable_sticky_info %} bundle-pdp--sticky{% endif %}"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-skip-cart="{{ section.settings.skip_cart }}"
  data-lock-gallery="{{ section.settings.lock_gallery_image }}"
>
  {{ 'section-main-product.css' | asset_url | stylesheet_tag }}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
  {{ 'component-slider.css' | asset_url | stylesheet_tag }}
  {{ 'bundle-pdp.css' | asset_url | stylesheet_tag }}

  {% unless product.has_only_default_variant %}
    {{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch-input.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch.css' | asset_url | stylesheet_tag }}
  {% endunless %}

  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }
    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}

  {% if section.settings.hide_slider_buttons_mobile %}
    <style>
      @media screen and (max-width: 749px) {
        #shopify-section-{{ section.id }} slider-component .slider-button {
          display: none !important;
        }
      }
    </style>
  {% endif %}

  <script src="{{ 'bundle-pdp.js' | asset_url }}" defer="defer"></script>
  {% if section.settings.image_zoom == 'hover' %}
    <script id="EnableZoomOnHover-bundle" src="{{ 'magnify.js' | asset_url }}" defer="defer"></script>
  {% endif %}
  {%- if request.design_mode -%}
    <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {% assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src' %}
  {%- assign product_form_id = 'bundle-product-form-' | append: section.id -%}

  {%- liquid
    assign flavor_option_index = -1
    for opt in product.options_with_values
      assign opt_name_dc = opt.name | downcase
      if opt_name_dc contains 'flavor' or opt_name_dc contains 'flavour' or opt_name_dc contains 'taste'
        assign flavor_option_index = forloop.index0
        break
      endif
    endfor
    if flavor_option_index == -1 and product.options_with_values.size > 0
      assign flavor_option_index = 0
    endif

    assign bundle_option_index = -1
    assign bundle_name_dc = section.settings.bundle_option_name | downcase | strip
    for opt in product.options_with_values
      assign opt_name_dc = opt.name | downcase | strip
      if opt_name_dc == bundle_name_dc
        assign bundle_option_index = forloop.index0
        break
      endif
    endfor
    if bundle_option_index == -1
      for opt in product.options_with_values
        assign opt_name_dc = opt.name | downcase
        if opt_name_dc contains 'bundle' or opt_name_dc contains 'size' or opt_name_dc contains 'pack'
          assign bundle_option_index = forloop.index0
          break
        endif
      endfor
    endif

    assign popular_tile_int = section.settings.popular_tile | plus: 0
    assign default_tile_int = section.settings.default_tile | plus: 0

    assign tile_1_resolved_price = section.settings.tile_1_price
    if bundle_option_index >= 0
      for v in product.variants
        if v.options[bundle_option_index] == section.settings.tile_1_bundle_value
          assign tile_1_resolved_price = v.price
          break
        endif
      endfor
    endif
  -%}

  <div class="page-width bundle-pdp__page">
    <div class="bundle-pdp__brand">{{ section.settings.brand_label }}</div>

    {%- if section.settings.show_title_at_top -%}
      <h1 class="bundle-pdp__title bundle-pdp__title--top">{{ product.title | escape }}</h1>
    {%- endif -%}

    <div class="bundle-pdp__grid">
      <div class="bundle-pdp__media product product--{{ section.settings.gallery_layout }} product--mobile-{{ section.settings.mobile_thumbnails }}">
        {%- if section.settings.lock_gallery_image -%}
          {% render 'product-media-gallery', variant_images: variant_images, featured_media_override: product.featured_media %}
        {%- else -%}
          {% render 'product-media-gallery', variant_images: variant_images %}
        {%- endif -%}
      </div>

      <div class="bundle-pdp__info">
        <section
          id="BundleProductInfo-{{ section.id }}"
          class="bundle-pdp__info-inner"
        >
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when '@app' -%}
                {% render block %}
              {%- when 'title' -%}
                <h1 class="bundle-pdp__title" {{ block.shopify_attributes }}>{{ product.title | escape }}</h1>
              {%- when 'text' -%}
                <p
                  class="bundle-pdp__text inline-richtext{% if block.settings.text_style == 'uppercase' %} caption-with-letter-spacing{% elsif block.settings.text_style == 'subtitle' %} subtitle{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  {{- block.settings.text -}}
                </p>
              {%- when 'description' -%}
                {%- if product.description != blank -%}
                  <div class="bundle-pdp__description rte" {{ block.shopify_attributes }}>
                    {{ product.description }}
                  </div>
                {%- endif -%}
              {%- when 'custom_liquid' -%}
                {{ block.settings.custom_liquid }}
              {%- when 'price' -%}
                <div class="bundle-pdp__inline-price" id="bundle-price-{{ section.id }}" role="status" {{ block.shopify_attributes }}>
                  {%- render 'price', product: product, use_variant: true, show_badges: true, price_class: 'price--large' -%}
                </div>
              {%- when 'share' -%}
                {% liquid
                  assign share_url = product.selected_variant.url | default: product.url | prepend: request.origin
                  render 'share-button', block: block, share_link: share_url
                %}
              {%- when 'benefit' -%}
                {%- comment -%} Rendered below the mix caption, not here. {%- endcomment -%}
            {%- endcase -%}
          {%- endfor -%}

          <div class="bundle-pdp__quantity-section">
            <p class="bundle-pdp__section-label">{{ section.settings.quantity_heading }}</p>
            <div
              class="bundle-pdp__tiles"
              role="radiogroup"
              aria-label="{{ section.settings.quantity_heading | escape }}"
              data-bundle-option-index="{{ bundle_option_index }}"
              data-single-bundle-value="{{ section.settings.single_bundle_value | escape }}"
            >
              {%- for i in (1..3) -%}
                {%- case i -%}
                  {%- when 1 -%}
                    {%- assign tile_label = section.settings.tile_1_label -%}
                    {%- assign tile_sub = section.settings.tile_1_sub -%}
                    {%- assign tile_bundle_value = section.settings.tile_1_bundle_value -%}
                    {%- assign tile_fallback_price = section.settings.tile_1_price -%}
                    {%- assign tile_sticks = section.settings.tile_1_sticks -%}
                  {%- when 2 -%}
                    {%- assign tile_label = section.settings.tile_2_label -%}
                    {%- assign tile_sub = section.settings.tile_2_sub -%}
                    {%- assign tile_bundle_value = section.settings.tile_2_bundle_value -%}
                    {%- assign tile_fallback_price = section.settings.tile_2_price -%}
                    {%- assign tile_sticks = section.settings.tile_2_sticks -%}
                  {%- when 3 -%}
                    {%- assign tile_label = section.settings.tile_3_label -%}
                    {%- assign tile_sub = section.settings.tile_3_sub -%}
                    {%- assign tile_bundle_value = section.settings.tile_3_bundle_value -%}
                    {%- assign tile_fallback_price = section.settings.tile_3_price -%}
                    {%- assign tile_sticks = section.settings.tile_3_sticks -%}
                {%- endcase -%}
                {%- liquid
                  assign resolved_price = tile_fallback_price
                  assign tile_image = product.featured_image
                  assign tile_media_id = ''
                  if bundle_option_index >= 0
                    for v in product.variants
                      if v.options[bundle_option_index] == tile_bundle_value
                        assign resolved_price = v.price
                        if v.featured_image
                          assign tile_image = v.featured_image
                        endif
                        if v.featured_media
                          assign tile_media_id = v.featured_media.id
                        endif
                        break
                      endif
                    endfor
                  endif

                  assign savings_pct = 0
                  if i > 1 and tile_1_resolved_price > 0
                    assign tile_1_total = tile_1_resolved_price | times: i
                    if resolved_price < tile_1_total
                      assign savings_pct = tile_1_total | minus: resolved_price | times: 100 | divided_by: tile_1_total
                    endif
                  endif
                -%}
                <button
                  type="button"
                  class="bundle-pdp__tile{% if popular_tile_int == i %} bundle-pdp__tile--popular{% endif %}{% if default_tile_int == i %} is-selected{% endif %}"
                  role="radio"
                  aria-checked="{% if default_tile_int == i %}true{% else %}false{% endif %}"
                  data-bag-count="{{ i }}"
                  data-bundle-value="{{ tile_bundle_value | escape }}"
                  data-bag-price="{{ resolved_price }}"
                  data-media-id="{{ tile_media_id }}"
                >
                  {%- if popular_tile_int == i -%}
                    <span class="bundle-pdp__tile-badge">{{ section.settings.popular_label }}</span>
                  {%- endif -%}
                  <span class="bundle-pdp__tile-img" aria-hidden="true">
                    {%- if tile_image -%}
                      <img src="{{ tile_image | image_url: width: 200 }}" alt="" loading="lazy" width="80" height="80">
                    {%- endif -%}
                  </span>
                  <span class="bundle-pdp__tile-label">{{ tile_label }}</span>
                  <span class="bundle-pdp__tile-sub">{{ tile_sub }}</span>
                  <span class="bundle-pdp__tile-price">
                    {{ resolved_price | money }}
                    {%- if section.settings.tile_badge_mode == 'savings' and savings_pct > 0 -%}
                      <span class="bundle-pdp__tile-save">SAVE {{ savings_pct }}%</span>
                    {%- elsif section.settings.tile_badge_mode == 'per_stick' and tile_sticks > 0 -%}
                      {%- assign cost_per_stick = resolved_price | divided_by: tile_sticks -%}
                      <span class="bundle-pdp__tile-save bundle-pdp__tile-per-stick">{{ cost_per_stick | money }} {{ section.settings.per_stick_label }}</span>
                    {%- endif -%}
                  </span>
                </button>
              {%- endfor -%}
            </div>
          </div>

          {%- if flavor_option_index >= 0 -%}
            {%- assign flavor_option = product.options_with_values[flavor_option_index] -%}
            <div class="bundle-pdp__flavors-section">
              <p class="bundle-pdp__section-label">{{ section.settings.flavor_heading }}</p>
              <div
                class="bundle-pdp__bags"
                data-flavor-option-index="{{ flavor_option_index }}"
                data-bundle-option-index="{{ bundle_option_index }}"
                data-single-bundle-value="{{ section.settings.single_bundle_value | escape }}"
              >
                {%- for i in (1..3) -%}
                  {%- liquid
                    case i
                      when 1
                        assign bag_bundle_value = section.settings.tile_1_bundle_value
                      when 2
                        assign bag_bundle_value = section.settings.tile_2_bundle_value
                      when 3
                        assign bag_bundle_value = section.settings.tile_3_bundle_value
                    endcase

                    assign bag_image = product.featured_image
                    if product.metafields.custom.bundle_thumb != blank
                      assign bag_image = product.metafields.custom.bundle_thumb.value
                    elsif bundle_option_index >= 0
                      for v in product.variants
                        if v.options[bundle_option_index] == bag_bundle_value
                          if v.featured_image
                            assign bag_image = v.featured_image
                          endif
                          break
                        endif
                      endfor
                    endif
                  -%}
                  <div class="bundle-pdp__bag-row" data-bag-index="{{ i }}">
                    <span class="bundle-pdp__bag-label">{{ section.settings.bag_label_prefix }} {{ i }}</span>
                    <span class="bundle-pdp__bag-thumb" aria-hidden="true">
                      {%- if bag_image -%}
                        <img src="{{ bag_image | image_url: width: 80 }}" alt="" loading="lazy" width="32" height="32">
                      {%- endif -%}
                    </span>
                    <div class="bundle-pdp__flavor-options">
                      {%- for value in flavor_option.values -%}
                        <button
                          type="button"
                          class="bundle-pdp__flavor-pill{% if forloop.first %} is-selected{% endif %}"
                          data-flavor-value="{{ value | escape }}"
                          aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
                        >
                          {{ value }}
                        </button>
                      {%- endfor -%}
                    </div>
                  </div>
                {%- endfor -%}
              </div>
              <p class="bundle-pdp__mix-caption">
                <span class="bundle-pdp__mix-icon" aria-hidden="true">
                  {%- render 'bundle-pdp-icon',
                    image: section.settings.mix_icon,
                    url: section.settings.mix_icon_url,
                    default: 'icon-3d-model.svg',
                    width: 14, height: 14 -%}
                </span>
                {{ section.settings.mix_label }}
              </p>
            </div>
          {%- endif -%}

          {%- assign benefit_blocks = section.blocks | where: 'type', 'benefit' -%}
          {%- if benefit_blocks.size > 0 -%}
            <div class="bundle-pdp__benefits">
              {%- for block in benefit_blocks -%}
                <article class="bundle-pdp__benefit" {{ block.shopify_attributes }}>
                  <span class="bundle-pdp__benefit-icon" aria-hidden="true">
                    {%- if block.settings.icon != blank -%}
                      <img src="{{ block.settings.icon | image_url: width: 80 }}" alt="" loading="lazy" width="40" height="40">
                    {%- elsif block.settings.icon_url != blank -%}
                      <img src="{{ block.settings.icon_url }}" alt="" loading="lazy" width="40" height="40">
                    {%- endif -%}
                  </span>
                  <span class="bundle-pdp__benefit-label">{{ block.settings.label }}</span>
                </article>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </section>
      </div>

      <div class="bundle-pdp__purchase">
        <div class="bundle-pdp__purchase-card">
          <h2 class="bundle-pdp__purchase-title">{{ section.settings.purchase_heading }}</h2>

          <div class="bundle-pdp__form" data-section-id="{{ section.id }}">
            <div class="product-form__error-message-wrapper" role="alert" hidden>
              <span class="svg-wrapper">{{- 'icon-error.svg' | inline_asset_content -}}</span>
              <span class="product-form__error-message"></span>
            </div>

            {%- form 'product', product, id: product_form_id, class: 'bundle-pdp__product-form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
              <input
                type="hidden"
                name="id"
                value="{{ product.selected_or_first_available_variant.id }}"
                class="product-variant-id"
              >
              <input type="hidden" name="quantity" value="1">
              <input type="hidden" name="selling_plan" value="" id="BundleSellingPlan-{{ section.id }}" disabled>

              {%- assign first_selling_plan_group = product.selling_plan_groups | first -%}
              {%- assign has_selling_plans = false -%}
              {%- if first_selling_plan_group and first_selling_plan_group.selling_plans.size > 0 -%}
                {%- assign has_selling_plans = true -%}
              {%- endif -%}

              {%- assign discount_pct = 0 -%}
              {%- if has_selling_plans -%}
                {%- assign first_plan = first_selling_plan_group.selling_plans[0] -%}
                {%- if first_plan.price_adjustments[0] and first_plan.price_adjustments[0].value_type == 'percentage' -%}
                  {%- assign discount_pct = first_plan.price_adjustments[0].value -%}
                {%- endif -%}
              {%- endif -%}
              {%- assign discount_factor = 100 | minus: discount_pct | divided_by: 100.0 -%}

              {%- if has_selling_plans -%}

               <label class="bundle-pdp__option bundle-pdp__option--onetime{% unless has_selling_plans %} is-selected{% endunless %}">
                <input type="radio" name="bundle-purchase-mode" value="onetime" {% unless has_selling_plans %}checked{% endunless %}>
                <span class="bundle-pdp__option-radio" aria-hidden="true"></span>
                <span class="bundle-pdp__option-body">
                  <span class="bundle-pdp__option-row">
                    <span class="bundle-pdp__option-title">{{ section.settings.onetime_title }}</span>
                    <span class="bundle-pdp__option-price" data-onetime-price>{{ product.selected_or_first_available_variant.price | money }}</span>
                  </span>
                </span>
              </label>
              
                <label
                  class="bundle-pdp__option bundle-pdp__option--subscribe is-selected"
                  data-subscribe-discount-pct="{{ discount_pct }}"
                >
                  <input
                    type="radio"
                    name="bundle-purchase-mode"
                    value="subscribe"
                    data-selling-plan-id="{{ first_selling_plan_group.selling_plans[0].id }}"
                    checked
                  >
                  <span class="bundle-pdp__option-radio" aria-hidden="true"></span>
                  <span class="bundle-pdp__option-body">
                    <span class="bundle-pdp__option-row">
                      <span class="bundle-pdp__option-title">
                        {{ section.settings.subscribe_title }}
                        {%- if discount_pct > 0 %} {{ discount_pct }}%{%- endif -%}
                      </span>
                      <span class="bundle-pdp__option-tag">{{ section.settings.subscribe_tag }}</span>
                    </span>
                    <span class="bundle-pdp__option-meta">
                      <select class="bundle-pdp__frequency" aria-label="Delivery frequency" data-selling-plan-select>
                        {%- for plan in first_selling_plan_group.selling_plans -%}
                          <option value="{{ plan.id }}">{{ plan.name }}</option>
                        {%- endfor -%}
                      </select>
                      <span class="bundle-pdp__option-price">
                        <span data-subscribe-price>{{ product.selected_or_first_available_variant.price | times: discount_factor | round | money }}</span>
                        <s data-subscribe-compare>{{ product.selected_or_first_available_variant.price | money }}</s>
                      </span>
                    </span>
                  </span>
                </label>

                <div class="bundle-pdp__perks">
                  <span class="bundle-pdp__perk">
                    <span class="bundle-pdp__perk-icon" aria-hidden="true">
                      {%- render 'bundle-pdp-icon',
                        image: section.settings.perk_cancel_icon,
                        url: section.settings.perk_cancel_icon_url,
                        default: 'icon-reset.svg' -%}
                    </span>
                    {{ section.settings.perk_cancel }}
                  </span>
                  <span class="bundle-pdp__perk">
                    <span class="bundle-pdp__perk-icon" aria-hidden="true">
                      {%- render 'bundle-pdp-icon',
                        image: section.settings.perk_skip_icon,
                        url: section.settings.perk_skip_icon_url,
                        default: 'icon-stopwatch.svg' -%}
                    </span>
                    {{ section.settings.perk_skip }}
                  </span>
                  <span class="bundle-pdp__perk">
                    <span class="bundle-pdp__perk-icon" aria-hidden="true">
                      {%- render 'bundle-pdp-icon',
                        image: section.settings.perk_shipping_icon,
                        url: section.settings.perk_shipping_icon_url,
                        default: 'icon-truck.svg' -%}
                    </span>
                    {{ section.settings.perk_shipping }}
                  </span>
                </div>
              {%- endif -%}

             

              <div class="bundle-pdp__trust">
                <span class="bundle-pdp__trust-item">
                  <span class="bundle-pdp__trust-icon" aria-hidden="true">
                    {%- render 'bundle-pdp-icon',
                      image: section.settings.trust_ships_icon,
                      url: section.settings.trust_ships_icon_url,
                      default: 'icon-box.svg' -%}
                  </span>
                  {{ section.settings.trust_ships }}
                </span>
                <span class="bundle-pdp__trust-item">
                  <span class="bundle-pdp__trust-icon" aria-hidden="true">
                    {%- render 'bundle-pdp-icon',
                      image: section.settings.trust_secure_icon,
                      url: section.settings.trust_secure_icon_url,
                      default: 'icon-padlock.svg' -%}
                  </span>
                  {{ section.settings.trust_secure }}
                </span>
                <span class="bundle-pdp__trust-item">
                  <span class="bundle-pdp__trust-icon" aria-hidden="true">
                    {%- render 'bundle-pdp-icon',
                      image: section.settings.trust_founder_icon,
                      url: section.settings.trust_founder_icon_url,
                      default: 'icon-star.svg' -%}
                  </span>
                  {{ section.settings.trust_founder }}
                </span>
              </div>

              <div class="bundle-pdp__submit-flex-shipping">
              <button
                id="BundleSubmitButton-{{ section.id }}"
                type="submit"
                name="add"
                class="bundle-pdp__submit"
                {% if product.selected_or_first_available_variant.available == false or product.selected_or_first_available_variant == null %}disabled{% endif %}
              >
                <span class="bundle-pdp__submit-price">
                  <strong data-total-price>{{ product.selected_or_first_available_variant.price | money }}</strong>
                  <span data-total-meta>({{ section.settings.default_tile }} bags)</span>
                </span>
                <span class="bundle-pdp__submit-divider" aria-hidden="true"></span>
                <span class="bundle-pdp__submit-label">
                  {%- if product.selected_or_first_available_variant == null -%}
                    {{ 'products.product.unavailable' | t }}
                  {%- elsif product.selected_or_first_available_variant.available == false -%}
                    {{ 'products.product.sold_out' | t }}
                  {%- else -%}
                    {{ 'products.product.add_to_cart' | t }}
                  {%- endif -%}
                </span>
                {%- render 'loading-spinner' -%}
              </button>

              <p class="bundle-pdp__shipping-note">{{ section.settings.shipping_note }}</p>
            </div>
            {%- endform -%}
          </div>

          <div class="bundle-pdp__guarantee">
            <span class="bundle-pdp__guarantee-icon" aria-hidden="true">
              {%- render 'bundle-pdp-icon',
                image: section.settings.guarantee_icon,
                url: section.settings.guarantee_icon_url,
                default: 'icon-success.svg',
                width: 24, height: 24 -%}
            </span>
            <div>
              <p class="bundle-pdp__guarantee-title">{{ section.settings.guarantee_title }}</p>
              <p class="bundle-pdp__guarantee-text">{{ section.settings.guarantee_text }}</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="bundle-pdp__sticky-cta" data-bundle-sticky-cta aria-hidden="true">
      <button
        type="button"
        class="bundle-pdp__submit bundle-pdp__sticky-submit"
        data-bundle-sticky-submit
        aria-label="{{ 'products.product.add_to_cart' | t }}"
        {% if product.selected_or_first_available_variant.available == false or product.selected_or_first_available_variant == null %}disabled{% endif %}
      >
        <span class="bundle-pdp__submit-price">
          <strong data-total-price>{{ product.selected_or_first_available_variant.price | money }}</strong>
          <span data-total-meta>({{ section.settings.default_tile }} bags)</span>
        </span>
        <span class="bundle-pdp__submit-divider" aria-hidden="true"></span>
        <span class="bundle-pdp__submit-label">
          {%- if product.selected_or_first_available_variant == null -%}
            {{ 'products.product.unavailable' | t }}
          {%- elsif product.selected_or_first_available_variant.available == false -%}
            {{ 'products.product.sold_out' | t }}
          {%- else -%}
            {{ 'products.product.add_to_cart' | t }}
          {%- endif -%}
        </span>
      </button>
    </div>

    <script type="application/json" data-bundle-product-variants>
      {{ product.variants | json }}
    </script>

    {% render 'product-media-modal', variant_images: variant_images %}

    {%- if product.media.size > 0 -%}
      <script src="{{ 'product-modal.js' | asset_url }}" defer="defer"></script>
      <script src="{{ 'media-gallery.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    <script type="application/ld+json">
      {{ product | structured_data }}
    </script>
  </div>
</div>

{% schema %}
{
  "name": "Bundle Product",
  "tag": "section",
  "class": "section section-bundle-pdp",
  "blocks": [
    { "type": "@app" },
    { "type": "title", "name": "Title", "limit": 1 },
    { "type": "description", "name": "Description", "limit": 1 },
