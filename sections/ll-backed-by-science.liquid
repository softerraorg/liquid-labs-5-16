{% style %}
  #shopify-section-{{ section.id }} .ll-backed-by-science-section {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    background-color: {{ section.settings.background_color }};
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
  }

  .ll-backed-by-science-intro {
    text-align: center;
    max-width: 880px;
    margin: 0 auto 3.2rem;
  }

  .ll-backed-by-science-heading {
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    font-size: calc(var(--font-heading-scale) * 3rem);
    letter-spacing: calc(var(--font-heading-scale) * 0.06rem);
    line-height: calc(1 + 0.3 / max(1, var(--font-heading-scale)));
    margin: 0 0 1.2rem;
    color: {{ section.settings.heading_color }};
    word-break: break-word;
  }

  .ll-backed-by-science-subheading {
    font-family: var(--font-body-family);
    font-style: var(--font-body-style);
    font-size: 1.5rem;
    letter-spacing: 0.06rem;
    line-height: calc(1 + 0.8 / var(--font-body-scale));
    margin: 0;
    color: {{ section.settings.subheading_color }};
  }

  .ll-backed-by-science-subheading p {
    margin: 0 0 0.5em;
  }

  .ll-backed-by-science-subheading p:last-child {
    margin-bottom: 0;
  }

  .ll-backed-by-science-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.6rem;
  }

  .ll-backed-by-science-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: {{ section.settings.card_background }};
    border-radius: 1.6rem;
    overflow: hidden;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
  }

  .ll-backed-by-science-card-image {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #000;
  }

  .ll-backed-by-science-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ll-backed-by-science-card-icon {
    width: 5.6rem;
    height: 5.6rem;
    margin: -2.8rem auto 0;
    
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    position: relative;
    z-index: 2;
  }

  .ll-backed-by-science-card-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .ll-backed-by-science-card-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    text-align: center;
    padding: 1.4rem 1.8rem 2.4rem;
    gap: 0;
  }

  .ll-backed-by-science-card-title {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    font-size: 1.8rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0.06rem;
    margin: 0 0 0.8rem;
    color: {{ section.settings.card_title_color }};
  }

  .ll-backed-by-science-card-title-amount {
    font-weight: 600;
    margin-left: 2px;
  }

  .ll-backed-by-science-card-divider {
    border: 0;
    border-top: 2px solid #e8e8e8;
    width: 3.2rem;
    margin: 0.6rem auto 1rem;
    height: 0;
  }

  .ll-backed-by-science-card-description {
    font-family: var(--font-body-family);
    font-size: 1.4rem;
    letter-spacing: 0.06rem;
    line-height: 1.5;
    margin: 0;
    color: {{ section.settings.card_text_color }};
  }

  .ll-backed-by-science-card-description p {
    margin: 0 0 0.3em;
  }

  .ll-backed-by-science-card-description p:last-child {
    margin-bottom: 0;
  }

  @media screen and (min-width: 600px) {
    .ll-backed-by-science-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem;
    }
  }

  @media screen and (min-width: 1024px) {
    #shopify-section-{{ section.id }} .ll-backed-by-science-section {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }

    .ll-backed-by-science-intro {
      margin: 0 auto 4.8rem;
    }

    .ll-backed-by-science-heading {
      font-size: calc(var(--font-heading-scale) * 4rem);
      margin: 0 0 1.6rem;
    }

    .ll-backed-by-science-subheading {
      font-size: 1.6rem;
    }

    .ll-backed-by-science-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2.4rem;
    }

    .ll-backed-by-science-card {
      flex-direction: row;
      align-items: stretch;
      border-radius: 1.2rem;
      box-shadow: 0 0 5px rgba(0, 0, 0, 0.12);
    }

    .ll-backed-by-science-card-image {
      flex: 0 0 220px;
      max-width: 220px;
      width: auto;
      aspect-ratio: 1 / 1;
    }

    .ll-backed-by-science-card-icon,
    .ll-backed-by-science-card-divider {
      display: none;
    }

    .ll-backed-by-science-card-body {
      flex: 1;
      align-items: flex-start;
      justify-content: center;
      text-align: left;
      padding: 2.4rem 2.8rem;
    }

    .ll-backed-by-science-card-title {
      font-size: 2.4rem;
      margin: 0 0 1rem;
    }

    .ll-backed-by-science-card-description {
      font-size: 1.6rem;
    }
  }
{% endstyle %}

<div class="ll-backed-by-science-section">
  <div class="page-width">
    <div class="ll-backed-by-science-intro">
      {%- if section.settings.heading != blank -%}
        <h2 class="ll-backed-by-science-heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <div class="ll-backed-by-science-subheading rte">{{ section.settings.subheading }}</div>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="ll-backed-by-science-grid">
        {%- for block in section.blocks -%}
          <div class="ll-backed-by-science-card" {{ block.shopify_attributes }}>
            <div class="ll-backed-by-science-card-image">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 800
                  | image_tag:
                    loading: 'lazy',
                    widths: '400, 600, 800',
                    sizes: '(min-width: 1024px) 220px, (min-width: 600px) 50vw, 100vw',
                    alt: block.settings.image.alt | escape
                }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>

            {%- if block.settings.icon != blank -%}
              <div class="ll-backed-by-science-card-icon" aria-hidden="true">
                {{
                  block.settings.icon
                  | image_url: width: 120
                  | image_tag:
                    loading: 'lazy',
                    widths: '60, 120',
                    sizes: '32px',
                    alt: ''
                }}
              </div>
            {%- endif -%}

            <div class="ll-backed-by-science-card-body">
              {%- if block.settings.title != blank or block.settings.amount != blank -%}
                <h3 class="ll-backed-by-science-card-title">
                  {{- block.settings.title -}}
                  {%- if block.settings.amount != blank -%}
                    <span class="ll-backed-by-science-card-title-amount"> |{{ block.settings.amount }}</span>
                  {%- endif -%}
                </h3>
              {%- endif -%}

              <hr class="ll-backed-by-science-card-divider" />

              {%- if block.settings.description != blank -%}
                <div class="ll-backed-by-science-card-description rte">{{ block.settings.description }}</div>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "LL Backed by Science",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Backed by Science. Formulated for Performance."
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Every ingredient is carefully selected to support hydration, endurance, recovery, and daily performance with no unnecessary fillers or complicated mixes.</p>"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#353636"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color",
      "default": "#7c7d81"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card border",
      "default": "#cfdefa"
    },
    {
      "type": "color",
      "id": "card_title_color",
      "label": "Card title color",
      "default": "#353636"
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Card description color",
      "default": "#7c7d81"
    },
    {
      "type": "header",
      "content": "Padding — desktop"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Padding — mobile"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Mobile floating icon",
          "info": "Small square icon (e.g. dumbbell, droplet) that floats between the image and body on mobile/tablet. Hidden on desktop. ~40×40 PNG/SVG."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Creatine Monohydrate"
        },
        {
          "type": "text",
          "id": "amount",
          "label": "Amount",
          "info": "Shown after a divider, e.g. 5G, 150MG. Leave blank to hide."
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>Supports strength, muscle recovery, and daily performance while helping improve power output and hydration.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LL Backed by Science",
      "blocks": [
        {
          "type": "ingredient",
          "settings": {
            "title": "Creatine Monohydrate",
            "amount": "5G",
            "description": "<p>Supports strength, muscle recovery, and daily performance while helping improve power output and hydration.</p>"
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "title": "Coconut Water Powder",
            "description": "<p>Naturally sourced hydration support packed with electrolytes to help replenish and refresh faster.</p>"
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "title": "Potassium",
            "amount": "130MG",
            "description": "<p>Helps regulate fluid balance and supports proper muscle and nerve function for better recovery.</p>"
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "title": "Sodium",
            "amount": "150MG",
            "description": "<p>Essential electrolyte that helps maintain hydration balance and supports muscle function during activity.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
