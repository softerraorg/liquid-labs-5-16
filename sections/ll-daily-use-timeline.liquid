{% style %}
  #shopify-section-{{ section.id }} .ll-daily-use-section {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    background-color: {{ section.settings.badge_background }};
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .ll-daily-use-section .page-width {
    padding-left: 0;
    padding-right: 0;
    max-width: none;
  }

  .ll-daily-use-inner {
    background: transparent;
    padding: 0;
  }

  .ll-daily-use-intro {
    max-width: none;
    margin: 0 0 2.8rem;
    padding: 0 2rem;
    text-align: center;
  }

  .ll-daily-use-heading {
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    font-size: calc(var(--font-heading-scale) * 3rem);
    letter-spacing: calc(var(--font-heading-scale) * 0.06rem);
    line-height: calc(1 + 0.3 / max(1, var(--font-heading-scale)));
    margin: 0 0 1.2rem;
    color: #ffffff !important;
    word-break: break-word;
  }

  .ll-daily-use-description {
    font-family: var(--font-body-family);
    font-style: var(--font-body-style);
    font-size: 1.5rem;
    letter-spacing: 0.06rem;
    line-height: calc(1 + 0.8 / var(--font-body-scale));
    margin: 0;
    color: rgba(255, 255, 255, 0.85);
  }

  .ll-daily-use-description p {
    margin: 0 0 0.4em;
    color: #fff !important;
  }

  .ll-daily-use-description p:last-child {
    margin-bottom: 0;
  }

  .ll-daily-use-overlay {
    display: none;
  }

  .ll-daily-use-grid {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    gap: 1.6rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding: 0.4rem 2rem 0.8rem;
  }

  .ll-daily-use-grid::-webkit-scrollbar {
    display: none;
  }

  .ll-daily-use-card-row {
    flex: 0 0 calc(100% - 4rem);
    max-width: 34rem;
    scroll-snap-align: center;
    display: flex;
    padding-bottom: 0;
    position: relative;
  }

  .ll-daily-use-card-row::before,
  .ll-daily-use-mobile-marker,
  .ll-daily-use-mobile-stem {
    display: none;
  }

  .ll-daily-use-card {
    flex: 1;
    min-width: 0;
    width: 100%;
    position: relative;
    background: #ffffff;
    border: none;
    border-radius: 2.4rem;
    padding: 2.8rem 2.4rem;
    box-shadow: 0 18px 38px rgba(10, 24, 60, 0.18);
  }

  .ll-daily-use-card-description {
    font-family: var(--font-body-family);
    font-style: var(--font-body-style);
    font-size: 1.5rem;
    letter-spacing: 0.06rem;
    line-height: calc(1 + 0.8 / var(--font-body-scale));
    margin: 0 0 1.6rem;
    color: #7c7d81;
  }

  .ll-daily-use-card-description p {
    margin: 0 0 0.4em;
  }

  .ll-daily-use-card-description p:last-child {
    margin-bottom: 0;
  }

  .ll-daily-use-card-divider {
    border: 0;
    border-top: 1px solid #ccdefd;
    margin: 0 0 1.6rem;
    height: 0;
  }

  .ll-daily-use-card-badge {
    display: inline-block;
    background: {{ section.settings.badge_background }};
    color: {{ section.settings.badge_text_color }} !important;
    border-radius: 999px;
    padding: 0.6rem 1.4rem;
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    font-size: 1.2rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: calc(var(--font-heading-scale) * 0.06rem);
    text-transform: uppercase;
    margin: 0 0 1.6rem;
    width: max-content;
  }

  .ll-daily-use-card-title {
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    font-size: calc(var(--font-heading-scale) * 3rem) !important;
    letter-spacing: calc(var(--font-heading-scale) * 0.06rem);
    line-height: calc(1 + 0.3 / max(1, var(--font-heading-scale)));
    margin: 0 0 1.2rem;
    color: #353636 !important;
  }

  .ll-daily-use-card-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .ll-daily-use-card-list-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.4;
    color: #585858;
  }

  .ll-daily-use-card-list-item-icon {
    flex-shrink: 0;
    width: 2.2rem;
    height: 2.2rem;
    margin-top: 0;
    color: {{ section.settings.badge_background }} !important;
  }

  .ll-daily-use-card-list-item-icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .ll-daily-use-pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.9rem;
    margin-top: 2.4rem;
  }

  .ll-daily-use-pagination-dot {
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.28);
    border: 0;
    padding: 0;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .ll-daily-use-pagination-dot.is-active {
    background: #ffffff;
    transform: scale(1.15);
  }

  .ll-daily-use-swipe-hint {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    margin-top: 2rem;
    color: #ffffff;
    font-family: var(--font-body-family);
    font-style: var(--font-body-style);
    font-size: 1.4rem;
    font-weight: 500;
    letter-spacing: 0.06rem;
  }
.ll-daily-use-swipe-hint span{
  color: #fff !important;
}
  .ll-daily-use-swipe-hint svg {
    width: 2rem;
    height: 2rem;
    flex-shrink: 0;
  }


  @media screen and (min-width: 1024px) {
    #shopify-section-{{ section.id }} .ll-daily-use-section {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
      background-color: {{ section.settings.background_color }};
      overflow: visible;
    }

    #shopify-section-{{ section.id }} .ll-daily-use-section .page-width {
      padding-left: 5rem;
      padding-right: 5rem;
      max-width: var(--page-width);
    }

    .ll-daily-use-pagination,
    .ll-daily-use-swipe-hint {
      display: none !important;
    }

    .ll-daily-use-card-description.rte, .ll-daily-use-card-divider{
     display: none !important;
    }
    .ll-daily-use-intro {
      margin: 0 0 -70px;
      text-align: left;
      padding: 0;
    }
  .ll-daily-use-inner {
    background: #ffffff;
    border-radius: 2rem;
    box-shadow: 0 6px 32px rgba(15, 30, 70, 0.06), 0 1px 2px rgba(15, 30, 70, 0.04);
    padding: 3rem 2rem;
  }
    .ll-daily-use-heading {
      font-family: var(--font-heading-family);
      font-style: var(--font-heading-style);
      font-size: calc(var(--font-heading-scale) * 4.8rem);
      letter-spacing: calc(var(--font-heading-scale) * 0.06rem);
      line-height: calc(1 + 0.3 / max(1, var(--font-heading-scale)));
      margin: 0 0 1.6rem;
      max-width: 350px;
      color: {{ section.settings.heading_color }} !important;
    }

    .ll-daily-use-description {
      font-family: var(--font-body-family);
      font-style: var(--font-body-style);
      font-size: 1.6rem;
      letter-spacing: 0.06rem;
      line-height: calc(1 + 0.8 / var(--font-body-scale));
      max-width: 450px;
      color: {{ section.settings.description_color }};
    }
      .ll-daily-use-description.rte p{
        color: #000 !important;
      }
    .ll-daily-use-overlay {
      display: grid;
      grid-template-columns: repeat(var(--cols, 4), 1fr);
      gap: 2.4rem;
      position: relative;
      height: 24rem;
      margin: 0;
      --ll-milestone-pos: 70%;
    }

    .ll-daily-use-overlay-line {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      overflow: visible;
    }

    .ll-daily-use-overlay-arrow {
      position: absolute;
      width: 0.9rem;
      height: 0.9rem;
      left: var(--end-x, 95%);
      top: var(--end-y, 22%);
      margin: -0.8rem 0 0 -0.4rem;
      transform-origin: right;
      transform: rotate(-26deg);
      pointer-events: none;
      z-index: 2;
    }

    .ll-daily-use-overlay-arrow svg {
      width: 100%;
      height: 100%;
      display: block;
    }

    .ll-daily-use-milestone {
      position: relative;
      height: 100%;
    }

    .ll-daily-use-milestone-content {
      position: absolute;
      left: var(--ll-milestone-pos);
      transform: translateX(-50%);
      bottom: calc(
        (var(--y-pct) * 1%)
        - (1.3rem + (var(--idx) / (var(--total) - 1)) * 1.1rem)
      );
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.4rem;
      text-align: center;
      white-space: nowrap;
    }

    .ll-daily-use-milestone-week {
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      font-size: 1.3rem;
      font-weight: 700;
      color: {{ section.settings.badge_background }} !important;
      margin: 0;
      line-height: 1.2;
      letter-spacing: 0.04rem;
    }

    .ll-daily-use-milestone-label {
      font-family: var(--font-body-family);
      font-size: 1.4rem;
      color: {{ section.settings.card_text_color }};
      margin: 0;
      line-height: 1.2;
    }

    .ll-daily-use-milestone-dot {
      width: 1rem;
      height: 1rem;
      border-radius: 50%;
      background: {{ section.settings.badge_background }};
      margin-top: 0.4rem;
      box-shadow: 0 0 0 4px rgba(58, 106, 198, 0.08);
    }

    .ll-daily-use-milestone-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: calc(2.6rem + (var(--idx) / (var(--total) - 1)) * 2.6rem);
      height: calc(2.6rem + (var(--idx) / (var(--total) - 1)) * 2.6rem);
      border-radius: 50%;
      
      box-shadow: 0 0 0 3px rgba(58, 106, 198, 0.06), 0 1px 3px rgba(0, 0, 0, 0.06);
      margin-top: 0.6rem;
      
    }

    .ll-daily-use-milestone-icon img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      display: block;
    }

    .ll-daily-use-milestone-stem {
      position: absolute;
      left: var(--ll-milestone-pos);
      bottom: 0;
      transform: translateX(-50%);
      width: 0;
      height: calc(
        (var(--y-pct) * 1%)
        - (1.3rem + (var(--idx) / (var(--total) - 1)) * 1.1rem)
      );
      border-left: 1px dashed {{ section.settings.line_color }};
      pointer-events: none;
    }

    .ll-daily-use-milestone-stem::after {
      content: "";
      position: absolute;
      left: 50%;
      bottom: -0.5rem;
      transform: translateX(-50%);
      width: 1rem;
      height: 1rem;
      border-radius: 50%;
      background: {{ section.settings.badge_background }};
      box-shadow: 0 0 0 3px rgba(58, 106, 198, 0.08);
    }

    .ll-daily-use-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 2.4rem;
      overflow-x: visible;
      scroll-snap-type: none;
      padding: 0;
    }

    .ll-daily-use-card-row {
      display: flex;
      flex: 1 1 auto;
      max-width: none;
      flex-direction: column;
      height: 100%;
      padding-bottom: 0;
      gap: 0;
      scroll-snap-align: none;
    }

    .ll-daily-use-card {
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    /* .ll-daily-use-card-list {
      margin-top: auto;
    } */

    .ll-daily-use-inner {
      padding: 9rem 9rem;
    }

    .ll-daily-use-card-row::before,
    .ll-daily-use-mobile-marker,
    .ll-daily-use-mobile-stem {
      display: none;
    }

    .ll-daily-use-card {
      background: {{ section.settings.card_background }};
      border: 1px solid {{ section.settings.card_border_color }};
      border-radius: 1.8rem;
      box-shadow: none;
      padding: 2.4rem 2.2rem;
    }

    .ll-daily-use-card-badge {
      padding: 0.6rem 1.4rem;
      font-weight: 500;
      letter-spacing: 0.04rem;
      text-transform: none;
      margin: 0 0 1.4rem;
    }

    .ll-daily-use-card-title {
      font-size: 2rem !important;
      font-weight: 600;
      letter-spacing: 0.06rem;
      margin: 0 0 1.2rem;
      color: {{ section.settings.card_title_color }} !important;
    }

    .ll-daily-use-card-description {
      font-size: 1.5rem;
      color: {{ section.settings.card_text_color }};
    }

    .ll-daily-use-card-list {
      gap: 0.9rem;
    }

    .ll-daily-use-card-list-item {
      align-items: flex-start;
      gap: 0.9rem;
      font-family: var(--font-body-family);
      font-size: 1.3rem;
      font-weight: 400;
      color: {{ section.settings.card_text_color }};
    }

    .ll-daily-use-card-list-item-icon {
      width: 1.8rem;
      height: 1.8rem;
      margin-top: 0.2rem;
      color: {{ section.settings.check_color }} !important;
    }
  }
{% endstyle %}

<div class="ll-daily-use-section">
  <div class="page-width">
    <div class="ll-daily-use-inner">
    {%- if section.settings.heading != blank or section.settings.description != blank -%}
      <div class="ll-daily-use-intro">
        {%- if section.settings.heading != blank -%}
          <h2 class="ll-daily-use-heading">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <div class="ll-daily-use-description rte">{{ section.settings.description }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- assign card_count = section.blocks.size -%}

    {%- if section.settings.show_overlay and card_count > 1 -%}
      {%- assign col_width = 100.0 | divided_by: card_count -%}
      {%- assign x_first = col_width | times: 0.7 -%}
      {%- assign last_col_left = col_width | times: card_count -%}
      {%- assign last_col_left = last_col_left | minus: col_width -%}
      {%- assign x_last = last_col_left | plus: x_first -%}
      {%- assign x_mid_sum = x_first | plus: x_last -%}
      {%- assign x_mid = x_mid_sum | divided_by: 2 -%}
      {%- assign x_extend = x_last | plus: 5 -%}
      {%- assign curve_y_start = 80 -%}
      {%- assign curve_y_control = 58 -%}
      {%- assign curve_y_end = 30 -%}
      {%- assign n_minus_1 = card_count | minus: 1 -%}
      <div class="ll-daily-use-overlay" style="--cols: {{ card_count }}; --total: {{ card_count }};" aria-hidden="true">
        <svg
          class="ll-daily-use-overlay-line"
          viewBox="0 0 100 100"
          preserveAspectRatio="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M {{ x_first }},80 Q {{ x_mid }},58 {{ x_last }},30 L {{ x_extend }},22"
            fill="none"
            stroke="{{ section.settings.line_color }}"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"
            vector-effect="non-scaling-stroke"
          />
        </svg>
        <span class="ll-daily-use-overlay-arrow" style="--end-x: {{ x_extend }}%; --end-y: 22%;">
          <svg viewBox="0 0 12 12" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M 0 0 L 12 6 L 0 12 z" fill="{{ section.settings.line_color }}" />
          </svg>
        </span>
        {%- for block in section.blocks -%}
          {%- assign idx = forloop.index0 -%}
          {%- assign t_num = idx | times: 1.0 -%}
          {%- assign t = t_num | divided_by: n_minus_1 -%}
          {%- assign omt = 1.0 | minus: t -%}
          {%- assign omt_sq = omt | times: omt -%}
          {%- assign t_sq = t | times: t -%}
          {%- assign two_omt_t = omt | times: t | times: 2 -%}
          {%- assign term_a = omt_sq | times: curve_y_start -%}
          {%- assign term_b = two_omt_t | times: curve_y_control -%}
          {%- assign term_c = t_sq | times: curve_y_end -%}
          {%- assign y_bezier = term_a | plus: term_b | plus: term_c -%}
          {%- assign y_pct_from_bottom = 100 | minus: y_bezier -%}
          <div
            class="ll-daily-use-milestone"
            style="--idx: {{ idx }}; --y-pct: {{ y_pct_from_bottom }};"
          >
            <span class="ll-daily-use-milestone-stem"></span>
            <div class="ll-daily-use-milestone-content">
              {%- if block.settings.badge_text != blank -%}
                <p class="ll-daily-use-milestone-week">{{ block.settings.badge_text }}</p>
              {%- endif -%}
              {%- if block.settings.milestone_label != blank -%}
                <p class="ll-daily-use-milestone-label">{{ block.settings.milestone_label }}</p>
              {%- elsif block.settings.title != blank -%}
                <p class="ll-daily-use-milestone-label">{{ block.settings.title }}</p>
              {%- endif -%}
              {%- if block.settings.milestone_icon != blank -%}
                <span class="ll-daily-use-milestone-icon">
                  {{
                    block.settings.milestone_icon
                    | image_url: width: 160
                    | image_tag:
                      loading: 'lazy',
                      widths: '60, 100, 160',
                      sizes: '52px',
                      alt: block.settings.milestone_icon.alt | escape
                  }}
                </span>
              {%- else -%}
                <span class="ll-daily-use-milestone-dot"></span>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if card_count > 0 -%}
      <div class="ll-daily-use-grid" data-ll-daily-use-grid>
        {%- for block in section.blocks -%}
          <div class="ll-daily-use-card-row" data-ll-daily-use-card-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
            <div class="ll-daily-use-mobile-marker" aria-hidden="true">
              {%- if block.settings.milestone_icon != blank -%}
                {{
                  block.settings.milestone_icon
                  | image_url: width: 100
                  | image_tag:
                    loading: 'lazy',
                    widths: '40, 60, 100',
                    sizes: '32px',
                    alt: ''
                }}
              {%- else -%}
                <span class="ll-daily-use-mobile-marker-dot"></span>
              {%- endif -%}
            </div>

            <span class="ll-daily-use-mobile-stem" aria-hidden="true">
              <span class="ll-daily-use-mobile-stem-dot"></span>
            </span>

            <div class="ll-daily-use-card">
              {%- if block.settings.badge_text != blank -%}
                <span class="ll-daily-use-card-badge">{{ block.settings.badge_text }}</span>
              {%- endif -%}

              {%- if block.settings.title != blank -%}
                <h3 class="ll-daily-use-card-title">{{ block.settings.title }}</h3>
              {%- endif -%}

              {%- if block.settings.description != blank -%}
                <div class="ll-daily-use-card-description rte">{{ block.settings.description }}</div>
              {%- endif -%}

              {%- assign items = block.settings.items | newline_to_br | split: '<br />' -%}
              {%- if items.size > 0 -%}
                {%- if block.settings.description != blank -%}
                  <hr class="ll-daily-use-card-divider" />
                {%- endif -%}
                <ul class="ll-daily-use-card-list">
                  {%- for item in items -%}
                    {%- assign item_text = item | strip -%}
                    {%- if item_text != blank -%}
                      <li class="ll-daily-use-card-list-item">
                        <span class="ll-daily-use-card-list-item-icon" aria-hidden="true">
                          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <circle cx="12" cy="12" r="11" fill="currentColor" />
                            <path d="M7.5 12.5L10.5 15.5L16.5 9.5" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                          </svg>
                        </span>
                        <span>{{ item_text }}</span>
                      </li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>

      {%- if card_count > 1 -%}
        <div class="ll-daily-use-pagination" data-ll-daily-use-pagination aria-hidden="true">
          {%- for block in section.blocks -%}
            <button
              type="button"
              class="ll-daily-use-pagination-dot{% if forloop.first %} is-active{% endif %}"
              data-ll-daily-use-dot="{{ forloop.index0 }}"
              aria-label="Go to slide {{ forloop.index }}"
            ></button>
          {%- endfor -%}
        </div>

        <div class="ll-daily-use-swipe-hint" aria-hidden="true">
       <svg width="54" height="66" viewBox="0 0 54 66" fill="none" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
<rect width="54" height="66" fill="url(#pattern0_49_118)"/>
<defs>
<pattern id="pattern0_49_118" patternContentUnits="objectBoundingBox" width="1" height="1">
<use xlink:href="#image0_49_118" transform="matrix(0.00471698 0 0 0.00385935 0 -0.00171527)"/>
</pattern>
<image id="image0_49_118" width="212" height="260" preserveAspectRatio="none" xlink:href="data:image/png;base64,"/>
</defs>
</svg>

          <span>Swipe to explore</span>
        </div>
      {%- endif -%}
    {%- endif -%}
    </div>
  </div>
</div>

{%- if card_count > 1 -%}
  <script>
    (function () {
      var section = document.getElementById('shopify-section-{{ section.id }}');
      if (!section) return;
      var grid = section.querySelector('[data-ll-daily-use-grid]');
      var pagination = section.querySelector('[data-ll-daily-use-pagination]');
      if (!grid || !pagination) return;
      var dots = pagination.querySelectorAll('[data-ll-daily-use-dot]');
      var cards = grid.querySelectorAll('[data-ll-daily-use-card-index]');
      if (!dots.length || !cards.length) return;

      function setActive(index) {
        dots.forEach(function (dot, i) {
          dot.classList.toggle('is-active', i === index);
        });
      }

      if ('IntersectionObserver' in window) {
        var observer = new IntersectionObserver(function (entries) {
          var best = null;
          entries.forEach(function (entry) {
            if (!best || entry.intersectionRatio > best.intersectionRatio) {
              best = entry;
            }
          });
          if (best && best.isIntersecting) {
            var idx = parseInt(best.target.getAttribute('data-ll-daily-use-card-index'), 10);
            if (!isNaN(idx)) setActive(idx);
          }
        }, { root: grid, threshold: [0.55, 0.75, 0.95] });

        cards.forEach(function (card) { observer.observe(card); });
      }

      dots.forEach(function (dot) {
        dot.addEventListener('click', function () {
          var idx = parseInt(dot.getAttribute('data-ll-daily-use-dot'), 10);
          var target = cards[idx];
          if (target) {
            target.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
          }
        });
      });
    })();
  </script>
{%- endif -%}

