          "type": "accordion_row",
          "settings": {
            "heading": "Ingredients",
            "content": "<p>Creatine monohydrate, sodium, potassium, magnesium, citric acid monohydrate, malic acid, acesulfame potassium, sucralose, silicon dioxide, natural and artificial flavors, and elderberry extract (for color).</p>",
            "open_by_default": false
          }
        },
        "accordion_row_x6EmHH": {
          "type": "accordion_row",
          "settings": {
            "heading": "How To Use",
            "content": "<p>Pour one stick into a water bottle or glass. Add 8 to 16 oz of water. Shake or stir until fully mixed and drink. Use up to twice a day.</p>",
